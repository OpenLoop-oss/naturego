# ===========================================
# E-Commerce API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# ============ Database ============
DATABASE_URL=postgresql://username:password@localhost:5432/ecommerce_db

# ============ Application ============
PORT=3000
NODE_ENV=development

# ============ JWT Authentication ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars

# Token Configuration (in minutes, hours, days)
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ============ Cookie Configuration ============
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============ App URLs ============
APP_FRONTEND_URL=http://localhost:3001

# ============ Email (Resend) ============
# Get your API key from https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@example.com
RESEND_FROM_NAME=Your App Name

# ============ Cloudinary (Image Upload) ============
# Get your credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ Razorpay (Payments) ============
# Get your credentials from https://dashboard.razorpay.com/app/keys
# Use test keys for development: https://dashboard.razorpay.com/app/keys?label=test_keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============ PhonePe (Payments) ============
# Apply at https://developer.phonepe.com for merchant integration
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=1
# PHONEPE_ENVIRONMENT=sandbox

# ============ Error Monitoring (Sentry) ============
# Get your DSN from https://sentry.io/settings/<your-org>/projects/<your-project>/keys
SENTRY_DSN=

# ============ Redis (Optional - for caching) ============
# REDIS_URL=redis://localhost:6379

# ============ Deployment (for CI/CD) ============
# STAGING_HOST=
# STAGING_USER=
# STAGING_APP_PATH=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
